# API Keys (OpenAI or Anthropic)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# LLM & Embedding Model Settings
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o-mini

# Qdrant Vector DB Settings
# Set QDRANT_HOST=localhost and QDRANT_PORT=6333 for Docker/Cloud service
# Or leave empty to use zero-friction local in-memory/disk storage
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=production_rag_knowledge_base
QDRANT_STORAGE_PATH=./data/qdrant_storage

# Retrieval & Fusion Parameters
DENSE_TOP_K=15
SPARSE_TOP_K=15
RRF_K=60
RERANK_TOP_K=5

# API Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true
